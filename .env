
# MongoDB root credentials (used to bootstrap the mongo container)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
MONGO_INITDB_DATABASE=admin

# MongoDB application user (created by init-mongo.sh, used by the API)
MONGO_APP_USER=admin
MONGO_APP_PASSWORD=admin
MONGO_APP_DB=offers

# MongoDB connection (used by the JobFinder service)
MONGO_USER=admin
MONGO_PASSWORD=admin
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB_NAME=offers
MONGO_AUTH_SOURCE=admin

# Mongo Express
ME_CONFIG_MONGODB_ADMINUSERNAME=root
ME_CONFIG_MONGODB_ADMINPASSWORD=example

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=63792

# JWT
JWT_SECRET=dfgdrfg5867

# JobFinder Docker image
JOBFINDER_IMAGE=727646479587.dkr.ecr.us-east-1.amazonaws.com/jobfinderdockerimage:latest
JOBFINDER_PORT=8000

# External offer HTTP client
OFFER_CLIENT_URI=http://ec2-18-194-181-208.eu-central-1.compute.amazonaws.com
OFFER_CLIENT_PORT=5057
