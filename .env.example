# MongoDB root credentials (used to bootstrap the mongo container)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=admin

# MongoDB application user (created by init-mongo.sh, used by the API)
MONGO_APP_USER=appuser
MONGO_APP_PASSWORD=changeme
MONGO_APP_DB=offers

# MongoDB connection (used by the JobFinder service)
MONGO_USER=appuser
MONGO_PASSWORD=changeme
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB_NAME=offers
MONGO_AUTH_SOURCE=admin

# Mongo Express
ME_CONFIG_MONGODB_ADMINUSERNAME=root
ME_CONFIG_MONGODB_ADMINPASSWORD=changeme

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=63792

# JWT
JWT_SECRET=replace-with-a-strong-random-secret

# JobFinder Docker image
JOBFINDER_IMAGE=your-registry/jobfinder:latest
JOBFINDER_PORT=8000

# External offer HTTP client
OFFER_CLIENT_URI=http://your-offer-host
OFFER_CLIENT_PORT=5057
